# Shared password required to log in at /admin and unlock edit mode.
# Only used by `npm run seed` to create the hashed password in Postgres — after
# that, the hash in the admin_credentials table is authoritative and this value
# is ignored. To rotate the password later, log in and use the dashboard's
# change-password form instead of editing this file.
ADMIN_PASSWORD=change-me

# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# PostgreSQL connection string. For local dev, create a database + role in
# pgAdmin (or psql) and point this at it, e.g.:
#   postgresql://pio_app:your-password@localhost:5432/pio_gmbh
DATABASE_URL=postgresql://user:password@localhost:5432/pio_gmbh

# Public production URL, no trailing slash. Used for canonical links, the
# sitemap, robots.txt, Open Graph/Twitter image URLs, and JSON-LD. Set this to
# the real domain once the site is deployed — until then it falls back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.pio-gmbh.example
